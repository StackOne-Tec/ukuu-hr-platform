# Cloud Firestore (Firebase Admin SDK). Set ONE of:
#   1. FIREBASE_SERVICE_ACCOUNT — the full service-account JSON (from Firebase
#      Console → Project settings → Service accounts → Generate new private key)
#      pasted inline as a single line, e.g.
#      FIREBASE_SERVICE_ACCOUNT='{"type":"service_account",...}'
#   2. GOOGLE_APPLICATION_CREDENTIALS — a path to the downloaded JSON file.
# FIREBASE_SERVICE_ACCOUNT=""
# GOOGLE_APPLICATION_CREDENTIALS=""
# Optional: overrides the project id from the service account.
# FIREBASE_PROJECT_ID=""
# Public web API key (from Firebase Console → Project settings → General →
# Your apps). Used only for server-side credential verification via the
# Identity Toolkit REST API — it is public by design, same key the client SDK
# would ship. REQUIRED for email/password sign-in.
# Firebase web API key (Firebase Console → Project settings → General →
# Your apps → Web app config). This key is an identifier for Firebase's
# Identity Toolkit API, not a private service-account credential.
FIREBASE_WEB_API_KEY=""
# Compatibility aliases accepted by the auth server if your host already uses
# one of these names instead:
# FIREBASE_API_KEY=""
# NEXT_PUBLIC_FIREBASE_API_KEY=""

# Client-side Firebase web config (same values as the Firebase web app config
# from Console → Project settings → General → Your apps → Web app). Baked into
# the browser bundle at build time. REQUIRED for the "Continue with Google"
# button, which runs signInWithPopup with these values.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
# Optional — analytics only, not needed for auth.
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""

# Resend API key for transactional email (password reset, welcome emails).
# Until a domain is verified at resend.com/domains, Resend only delivers to
# the account owner's email address (sandbox mode).
RESEND_API_KEY=""

# Sender address shown to recipients. Must use a domain verified in Resend;
# falls back to the shared onboarding@resend.dev sender when unset.
# EMAIL_FROM="Ukuu HR <no-reply@yourdomain.com>"

# Platform admin address notified by email whenever an access code is redeemed.
# Leave empty to disable.
# ADMIN_NOTIFY_EMAIL="admin@yourcompany.com"

# Google OAuth Web Client credentials — only used by the legacy redirect flow
# (/api/auth/google/start + /callback). The Google button now uses Firebase's
# built-in signInWithPopup, which needs no OAuth credentials. Leave these empty
# unless you deliberately keep the redirect flow.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# Must exactly match a redirect URI registered in Google Cloud Console.
# GOOGLE_REDIRECT_URI="https://www.ukuuhr.com/api/auth/google/callback"
