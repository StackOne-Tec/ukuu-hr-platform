# PostgreSQL connection string.
# On Render, this is provided by the managed PostgreSQL instance (ukuuhr-db):
# postgresql://<user>:<password>@<host>:5432/<database>
# The app adds sslmode=require and conservative connection timeouts for
# non-local PostgreSQL hosts when they are not already present.
DATABASE_URL=""

# Resend API key for transactional email (password reset, welcome emails).
# Until a domain is verified at resend.com/domains, Resend only delivers to
# the account owner's email address (sandbox mode).
RESEND_API_KEY=""

# Sender address shown to recipients. Must use a domain verified in Resend;
# falls back to the shared onboarding@resend.dev sender when unset.
# EMAIL_FROM="Ukuu HR <no-reply@yourdomain.com>"

# Platform admin address notified by email whenever an access code is redeemed.
# Leave empty to disable.
# ADMIN_NOTIFY_EMAIL="admin@yourcompany.com"

# Dev Mailbox (/dev/mailbox) — a browser view of the local email outbox used
# to test email flows without a provider. In development (NODE_ENV != production)
# it is available automatically when RESEND_API_KEY is unset. In production it
# is DISABLED by default (reset links must never be public) and can only be
# enabled deliberately, e.g. for a private staging box behind other auth.
# DEV_MAILBOX_ENABLED="false"
